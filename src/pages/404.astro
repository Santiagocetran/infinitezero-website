---
import "@fontsource-variable/geist/wght.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    /><title>Page not found — InfiniteZero</title><meta
      name="robots"
      content="noindex"
    /></head
  ><body
    ><main class="wrap section">
      <a class="brand" href={import.meta.env.BASE_URL}
        ><span aria-hidden="true">∞</span>InfiniteZero</a
      ><section class="section">
        <h1>That page isn’t here.</h1><p style="margin-block:24px">
          Return to the network and find your next step.
        </p><a class="button primary" href={import.meta.env.BASE_URL}
          >Back to home</a
        >
      </section>
    </main></body
  >
</html>
