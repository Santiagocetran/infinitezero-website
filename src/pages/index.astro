---
import { links } from "../data/links";
import Network from "../components/Network.astro";
import "@fontsource-variable/geist/wght.css";
import "../styles/global.css";
const base = import.meta.env.BASE_URL;
const pageUrl = Astro.site ? new URL(base, Astro.site) : undefined;
const previewUrl = pageUrl
  ? new URL("preview.png", pageUrl).href
  : `${base}preview.png`;
const paths = [
  {
    title: "Try the network",
    text: "Run the MNIST example as a client, auditor or aggregator on the experimental DevNet.",
    scope: "Live DevNet 1.0",
    href: links.live,
    action: "Start a training round",
    symbol: "◎",
  },
  {
    title: "Bring a model",
    text: "Explore model requirements, custom training services and what needs testing.",
    scope: "Development guides",
    href: links.models,
    action: "Explore model training",
    symbol: "◇",
  },
  {
    title: "Build an app",
    text: "Understand how client onboarding and model services could fit your application.",
    scope: "Development guides",
    href: links.clients,
    action: "Explore integrations",
    symbol: "⌘",
  },
  {
    title: "Make a contribution",
    text: "Help with code, documentation, testing, research or translations. Small contributions count.",
    scope: "Open development",
    href: links.issues,
    action: "Find a starting issue",
    symbol: "+",
  },
];
const faqs = [
  [
    "What is InfiniteZero?",
    "An open protocol for training shared AI models across distributed devices. Training happens near the data, while smart contracts coordinate the network. The project was previously called DIN; you will still see that name in the code.",
  ],
  [
    "Is the network ready to use?",
    "DevNet 1.0 is live on Optimism Sepolia for experiments. Expect bugs, changes and resets. DevNet 2.0 and its full economic layer are in development and are not deployed yet.",
  ],
  [
    "Does my data leave my device?",
    "Raw training data stays local, but model updates are shared. Local training alone does not guarantee privacy. Encryption and additional privacy protections are still being developed.",
  ],
  [
    "Which models can I train?",
    "MNIST is the only example tested end to end so far. Other model types need custom services and their own testing. The model training guide describes how to explore that work.",
  ],
  [
    "Do I need real money to participate?",
    "The experimental network uses test ETH on Optimism Sepolia. Test tokens have no real money value. Follow the live DevNet guide for setup and hardware requirements.",
  ],
  [
    "How can I help without writing code?",
    "Test the setup, improve an explanation, translate documentation or discuss a research question. The community chat and contribution guide are good places to start.",
  ],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>InfiniteZero — Bring AI to the data</title>
    <meta
      name="description"
      content="Train shared AI models where data lives. Explore InfiniteZero, an open protocol on Ethereum, try the experimental DevNet and help build the network."
    />
    <meta name="theme-color" content="#0a101b" />
    <meta property="og:title" content="InfiniteZero — Bring AI to the data" />
    <meta
      property="og:description"
      content="An open protocol for training shared AI models, right where data lives."
    />
    <meta property="og:type" content="website" />
    {pageUrl && <link rel="canonical" href={pageUrl.href} />}
    {pageUrl && <meta property="og:url" content={pageUrl.href} />}
    <meta property="og:image" content={previewUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
  </head>
  <body>
    <Network />
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="header">
      <a class="brand" href="#main" aria-label="InfiniteZero home"
        ><span aria-hidden="true">∞</span>InfiniteZero</a
      >
      <nav aria-label="Main navigation" class="desktop-nav">
        <a href="#how">How it works</a><a href="#participate">Get involved</a><a
          href={links.organization}>GitHub <span aria-hidden="true">↗</span></a
        >
      </nav>
      <button
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        hidden
        ><span></span><span></span><b class="sr-only">Open menu</b></button
      >
    </header>
    <dialog id="mobile-menu">
      <nav aria-label="Mobile navigation">
        <a href="#how">How it works</a><a href="#participate">Get involved</a><a
          href="#questions">Questions</a
        ><a href={links.organization}>GitHub</a>
      </nav><button class="menu-close">Close menu</button>
    </dialog>
    <main id="main" tabindex="-1">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <a class="live-link" href="#status"
            ><i></i> DevNet is live <span>Experimental</span></a
          >
          <h1 id="hero-title">Bring AI to<br />the data.</h1>
          <p class="hero-counterpart">Not the data to AI.</p>
          <p class="hero-description">
            An open protocol on Ethereum for training shared AI models on the
            world’s data, right where it lives.
          </p>
          <a class="button primary" href="#participate">Find your place</a>
          <div class="hero-proof">
            <span>Open source</span><span>Built on Ethereum</span><span
              >Apache 2.0</span
            >
          </div>
        </div>
        <div class="network-space" aria-hidden="true">
          <span>Local data. Shared learning.</span><span class="pointer-hint"
            >Move through the network</span
          >
        </div>
      </section>
      <section id="how" class="section wrap how" aria-labelledby="how-title">
        <div class="section-heading">
          <h2 id="how-title">
            Local knowledge.<br />Collective intelligence.
          </h2><p>
            Useful data lives across people, devices and communities.
            InfiniteZero lets them contribute to a shared model without
            gathering their raw data in one place.
          </p>
        </div>
        <ol class="steps">
          <li>
            <div class="step-art local-art" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div><span class="step-number">01</span><h3>
              Train where data lives
            </h3><p>
              Devices train a model using local data. The raw data stays where
              it is.
            </p>
          </li>
          <li>
            <div class="step-art updates-art" aria-hidden="true">
              <span></span><span></span><span></span>
            </div><span class="step-number">02</span><h3>
              Share what it learns
            </h3><p>
              Participants share model updates. Auditors evaluate them and
              aggregators combine them.
            </p>
          </li>
          <li>
            <div class="step-art shared-art" aria-hidden="true">
              <span>∞</span>
            </div><span class="step-number">03</span><h3>
              Build a shared model
            </h3><p>
              Smart contracts coordinate each round, bringing individual
              contributions together.
            </p>
          </li>
        </ol>
        <p class="privacy-note">
          Keeping data local is a starting point. Stronger privacy protections
          are still in development. <a href="#questions"
            >Explore the questions</a
          >
        </p>
      </section>
      <section class="statement wrap" aria-label="Our ambition">
        <p>
          {
            "Knowledge is everywhere."
              .split(" ")
              .map((word) => <span>{word} </span>)
          }<br />{
            "Let learning happen there."
              .split(" ")
              .map((word) => <span>{word} </span>)
          }
        </p><div>
          An open foundation for shared AI.<br />Built in public, one
          contribution at a time.
        </div>
      </section>
      <section
        id="participate"
        class="section wrap"
        aria-labelledby="participate-title"
      >
        <div class="section-heading">
          <h2 id="participate-title">A place for<br />your curiosity.</h2><p>
            Try a training round, bring a model or help build the protocol.
            Choose a starting point that fits you.
          </p>
        </div>
        <div class="path-grid">
          {
            paths.map((path) => (
              <article class="path-card">
                <>
                  <span class="path-symbol" aria-hidden="true">
                    {path.symbol}
                  </span>
                  <p class="scope">{path.scope}</p>
                  <h3>{path.title}</h3>
                  <p>{path.text}</p>
                  <a href={path.href}>
                    {path.action}
                    <span aria-hidden="true">↗</span>
                  </a>
                </>
              </article>
            ))
          }
        </div>
        <div class="support-links">
          <a href={links.partners}
            >Exploring with a community? Read the partner guide <span
              >(development)</span
            ></a
          ><a href={links.services}
            >Model services guide <span>(development)</span></a
          >
        </div>
      </section>
      <section id="status" class="wrap status" aria-labelledby="status-title">
        <div>
          <div class="status-label"><i></i> An experiment you can join</div><h2
            id="status-title"
          >
            Early. Open.<br />Moving forward.
          </h2><p>
            DevNet 1.0 runs on Optimism Sepolia. It uses test tokens, and MNIST
            is the first example tested end to end.
          </p><a class="text-link" href={links.live}
            >Read the live DevNet guide <span aria-hidden="true">↗</span></a
          >
        </div><div class="status-details">
          <div>
            <span class="status-pill">Live today</span><h3>DevNet 1.0</h3><p>
              Experimental training rounds.<br />Test ETH only. Expect changes
              and resets.
            </p>
          </div><div>
            <span class="status-pill planned">In development</span><h3>
              DevNet 2.0
            </h3><p>
              The full economic layer is being built. App fee sharing and
              community governance remain future goals.
            </p><a href={links.roadmap}
              >Explore the roadmap <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>
      </section>
      <section
        id="questions"
        class="section wrap faq"
        aria-labelledby="questions-title"
      >
        <div>
          <h2 id="questions-title">Good questions.<br />Honest answers.</h2><p>
            Still curious?<br /><a href={links.chat}
              >Talk with the community <span aria-hidden="true">↗</span></a
            >
          </p>
        </div><div class="questions">
          {
            faqs.map(([question, answer]) => (
              <details>
                <>
                  <summary>
                    {question}
                    <span aria-hidden="true">+</span>
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>
      <section class="final-cta wrap">
        <span class="final-symbol" aria-hidden="true">∞</span><h2>
          The next contribution<br />could be yours.
        </h2><p>Help shape an AI commons, built together.</p><a
          class="button primary"
          href="#participate">Find your place</a
        >
      </section>
    </main>
    <footer class="wrap">
      <div class="footer-top">
        <a class="brand" href="#main"
          ><span aria-hidden="true">∞</span>InfiniteZero</a
        ><nav aria-label="Project resources">
          <a href={links.whitepaper}>White paper</a><a href={links.contributing}
            >Contributing</a
          ><a href={links.organization}>GitHub</a><a href={links.chat}
            >Community</a
          >
        </nav>
      </div><div class="footer-bottom">
        <p>Open protocol. Shared possibility.</p><a href={links.overview}
          >Official overview &amp; translations</a
        ><p>No tracking. No cookies.</p>
      </div>
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
